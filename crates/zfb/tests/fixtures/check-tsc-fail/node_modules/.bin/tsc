#!/bin/sh
# Stub tsc that simulates a TypeScript type error.
# Used by crates/zfb/tests/check_command.rs to exercise the
# tsc-failure exit path of `zfb check` without a real TypeScript install.
# Exit 1 is the tsc convention for "type errors found".
echo "src/index.ts(1,1): error TS2345: Argument of type 'string' is not assignable to parameter of type 'number'." >&2
exit 1
