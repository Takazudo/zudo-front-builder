{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false
  },
  "include": [
    "consumer-compatibility.ts",
    "consumer-compatibility-highlight.ts",
    "consumer-compatibility-parse-to-ast.ts",
    "consumer-compatibility-slim.ts"
  ],
  "exclude": [
