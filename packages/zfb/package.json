{
  "name": "@takazudo/zfb",
  "version": "3.1.0",
  "private": false,
  "type": "module",
  "description": "Content-site engine on the web's Request/Response model — prerender to static HTML, serve on Cloudflare Workers, or run as a local content server inside your app. One Rust binary. SDK with islands, content collections, pagination, and config helpers.",
  "keywords": [
    "zfb",
    "static-site-generator",
    "ssg",
    "islands",
    "mdx",
    "content-collections",
    "rust"
  ],
  "license": "MIT",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/Takazudo)",
  "homepage": "https://takazudomodular.com/pj/zudo-front-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-front-builder.git",
    "directory": "packages/zfb"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-front-builder/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./content": {
      "types": "./src/content.ts",
      "default": "./src/content.ts"
    },
    "./paginate": {
      "types": "./src/paginate.ts",
      "default": "./src/paginate.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    },
    "./frontmatter": {
      "types": "./src/frontmatter.ts",
      "default": "./src/frontmatter.ts"
    },
    "./slugify": {
      "types": "./src/slugify.ts",
      "default": "./src/slugify.ts"
    },
    "./package.json": "./package.json",
    "./zudo-react": {
      "types": "./src/zudo-react/index.ts",
      "default": "./src/zudo-react/index.ts"
    },
    "./zudo-react/jsx-runtime": {
      "types": "./src/zudo-react/jsx-runtime.ts",
      "default": "./src/zudo-react/jsx-runtime.ts"
    },
    "./zudo-react/jsx-dev-runtime": {
      "types": "./src/zudo-react/jsx-dev-runtime.ts",
      "default": "./src/zudo-react/jsx-dev-runtime.ts"
    },
    "./zudo-react/server": {
      "types": "./src/zudo-react/server.ts",
      "default": "./src/zudo-react/server.ts"
    },
    "./zudo-react/client": {
      "types": "./src/zudo-react/client.ts",
      "default": "./src/zudo-react/client.ts"
    },
    "./zudo-react/testing": {
      "types": "./src/zudo-react/testing.ts",
      "default": "./src/zudo-react/testing.ts"
    }
  },
  "bin": {
    "zfb": "./bin/zfb.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@takazudo/zfb-darwin-arm64": "workspace:3.1.0",
    "@takazudo/zfb-darwin-x64": "workspace:3.1.0",
    "@takazudo/zfb-linux-arm64-gnu": "workspace:3.1.0",
    "@takazudo/zfb-linux-x64-gnu": "workspace:3.1.0",
    "@takazudo/zfb-win32-x64-msvc": "workspace:3.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./content": {
        "types": "./dist/content.d.ts",
        "default": "./dist/content.js"
      },
      "./paginate": {
        "types": "./dist/paginate.d.ts",
        "default": "./dist/paginate.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./plugins": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "./frontmatter": {
        "types": "./dist/frontmatter.d.ts",
        "default": "./dist/frontmatter.js"
      },
      "./slugify": {
        "types": "./dist/slugify.d.ts",
        "default": "./dist/slugify.js"
      },
      "./package.json": "./package.json",
      "./zudo-react": {
        "types": "./dist/zudo-react/index.d.ts",
        "default": "./dist/zudo-react/index.js"
      },
      "./zudo-react/jsx-runtime": {
        "types": "./dist/zudo-react/jsx-runtime.d.ts",
        "default": "./dist/zudo-react/jsx-runtime.js"
      },
      "./zudo-react/jsx-dev-runtime": {
        "types": "./dist/zudo-react/jsx-dev-runtime.d.ts",
        "default": "./dist/zudo-react/jsx-dev-runtime.js"
      },
      "./zudo-react/server": {
        "types": "./dist/zudo-react/server.d.ts",
        "default": "./dist/zudo-react/server.js"
      },
      "./zudo-react/client": {
        "types": "./dist/zudo-react/client.d.ts",
        "default": "./dist/zudo-react/client.js"
      },
      "./zudo-react/testing": {
        "types": "./dist/zudo-react/testing.d.ts",
        "default": "./dist/zudo-react/testing.js"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run && tsc -p tsconfig.zudo-react-fixture.json && tsc -p tsconfig.zudo-react-dev-fixture.json && tsc -p tsconfig.zudo-react-sdk-fixture.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^15.7.4",
    "typescript": "6.0.3",
    "typescript-5.9": "npm:typescript@5.9.3",
    "vitest": "4.1.11"
  }
}
