{
  "name": "@takazudo/zfb-slugify",
  "version": "4.3.0",
  "private": false,
  "type": "module",
  "description": "Zero-dependency heading-anchor slug utilities for zfb.",
  "keywords": [
    "zfb",
    "slugify",
    "heading",
    "anchor"
  ],
  "license": "MIT",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/takazudo)",
  "homepage": "https://takazudomodular.com/pj/zudo-front-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-front-builder.git",
    "directory": "packages/zfb-slugify"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-front-builder/issues"
  },
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "typescript-5.9": "npm:typescript@5.9.3",
    "typescript-6.0": "npm:typescript@6.0.3",
    "vite-plus": "catalog:"
  }
}
