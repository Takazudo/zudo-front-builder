      "default": "./src/index.ts"
    }
  },
  "bin": {
    "zfb-adapter-cloudflare": "./bin/cli.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
