{
  "name": "@takazudo/zfb-adapter-cloudflare",
  "version": "0.1.0-migration.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages adapter for zfb — wraps the zfb-runtime page router into a CF Worker entry (dist/_worker.js).",
  "license": "MIT",
  "main": "./src/index.ts",
