{
  "name": "@takazudo/zfb-adapter-cloudflare",
  "version": "4.2.0",
  "private": false,
  "type": "module",
  "description": "Content-site engine on the web's Request/Response model — prerender to static HTML, serve on Cloudflare Workers, or run as a local content server inside your app. One Rust binary. Cloudflare adapter: Workers Static Assets (Pages-compatible).",
  "keywords": [
    "zfb",
    "zfb-adapter",
    "cloudflare",
    "cloudflare-pages",
    "cloudflare-workers",
    "workers-static-assets",
    "ssg",
    "static-site-generator",
    "adapter"
  ],
  "license": "MIT",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/Takazudo)",
  "homepage": "https://takazudomodular.com/pj/zudo-front-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-front-builder.git",
    "directory": "packages/zfb-adapter-cloudflare"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-front-builder/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "default": "./src/build.ts"
    }
  },
  "bin": {
    "zfb-adapter-cloudflare": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src/worker-wrapper.mjs",
    "src/emit-worker.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./build": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc && cp src/worker-wrapper.mjs dist/worker-wrapper.mjs && cp src/emit-worker.mjs dist/emit-worker.mjs",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "pnpm typecheck:consumer && vp test run && pnpm test:packed-types",
    "test:packed-types": "pnpm build && node scripts/check-packed-types.mjs",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit && pnpm typecheck:consumer",
    "typecheck:consumer": "tsc --project tsconfig.consumer.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "typescript-5.9": "npm:typescript@5.9.3",
    "typescript-6.0": "npm:typescript@6.0.3",
    "vite-plus": "catalog:"
  }
}
