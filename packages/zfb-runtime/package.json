{
  "name": "@takazudo/zfb-runtime",
  "version": "0.2.0-migration.0",
  "private": true,
  "type": "module",
  "description": "JavaScript runtime for zfb static sites — Hono-backed page router, content snapshots, and client-side hydration.",
  "keywords": [
    "zfb",
    "zfb-runtime",
    "ssg",
    "static-site-generator",
    "hono",
    "page-router",
    "content-snapshot",
    "preact",
    "react",
    "view-transitions"
  ],
  "license": "MIT",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/Takazudo)",
  "homepage": "https://takazudomodular.com/pj/zudo-front-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-front-builder.git",
    "directory": "packages/zfb-runtime"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-front-builder/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    },
    "./client-router": {
      "types": "./src/client-router/index.ts",
      "default": "./src/client-router/index.ts"
    }
  },
  "files": [
    "src",
    "!src/__tests__",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "peerDependencies": {
    "@takazudo/zfb": "workspace:*"
  },
  "devDependencies": {
    "@takazudo/zfb": "workspace:*",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.7.4",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}
