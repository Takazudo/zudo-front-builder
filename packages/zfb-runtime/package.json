{
  "name": "@takazudo/zfb-runtime",
  "version": "0.1.0-next.69",
  "private": false,
  "type": "module",
  "description": "JavaScript runtime for zfb static sites — Hono-backed page router, content snapshots, and client-side hydration.",
  "keywords": [
    "zfb",
    "zfb-runtime",
    "ssg",
    "static-site-generator",
    "hono",
    "page-router",
    "content-snapshot",
    "preact",
    "react",
    "view-transitions"
  ],
  "license": "MIT",
  "author": "Takeshi Takatsudo <takazudo@gmail.com> (https://github.com/Takazudo)",
  "homepage": "https://takazudomodular.com/pj/zudo-front-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takazudo/zudo-front-builder.git",
    "directory": "packages/zfb-runtime"
  },
  "bugs": {
    "url": "https://github.com/Takazudo/zudo-front-builder/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    },
    "./client-router": {
      "types": "./src/client-router/index.ts",
      "default": "./src/client-router/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./snapshot": {
        "types": "./dist/snapshot.d.ts",
        "default": "./dist/snapshot.js"
      },
      "./client-router": {
        "types": "./dist/client-router/index.d.ts",
        "default": "./dist/client-router/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.25"
  },
  "peerDependencies": {
    "@takazudo/zfb": "workspace:*",
    "react": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@takazudo/zfb": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "happy-dom": "^15.7.4",
    "react": "^19.2.3",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}
