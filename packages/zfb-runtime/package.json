{
  "name": "@takazudo/zfb-runtime",
  "version": "0.2.0-migration.0",
  "private": true,
  "type": "module",
  "description": "zfb SSG runtime — Hono-based page router with embedded ContentSnapshot, driven by the embedded V8 host at build time (ADR-007).",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "peerDependencies": {
    "@takazudo/zfb": "workspace:*"
  },
  "devDependencies": {
    "@takazudo/zfb": "workspace:*",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.7.4",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}
