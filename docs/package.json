{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "run-p dev:zfb dev:history",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-p dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs --locale ja:src/content/docs-ja",
    "build": "zfb build --strict-broken",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "b4push": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@takazudo/zfb": "1.1.0",
    "@takazudo/zfb-runtime": "1.1.0",
    "@takazudo/zfb-md-wasm": "1.1.0",
    "@takazudo/zfb-adapter-cloudflare": "1.1.0",
    "@takazudo/zudo-doc": "4.5.0",
    "@takazudo/zudo-doc-history-server": "4.5.0",
    "@takazudo/zdtp": "0.4.9",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "gray-matter": "^4.0.0",
    "mermaid": "^11.12.3",
    "remark-cjk-friendly": "^2.0.1",
    "remark-directive": "^3.0.0",
    "katex": "^0.16.38",
    "diff": "^8.0.3",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "html-validate": "^10.0.0",
    "pagefind": "^1.4.0",
    "npm-run-all2": "^7.0.2",
    "wrangler": "4.85.0"
  }
}
