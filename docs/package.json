{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "run-parallel dev:zfb dev:history",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs --locale ja:src/content/docs-ja",
    "build": "zfb build --strict-broken",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:islands": "node scripts/assert-island-markers.mjs",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "test": "vp test run",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "b4push": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@takazudo/zfb": "5.1.4",
    "@takazudo/zfb-runtime": "5.1.4",
    "@takazudo/zfb-md-wasm": "5.1.4",
    "@takazudo/zfb-adapter-cloudflare": "5.1.4",
    "@takazudo/zudo-doc": "8.1.1",
    "@takazudo/zudo-doc-history-server": "8.1.1",
    "@takazudo/zdtp": "0.8.7",
    "zod": "^4.6.6",
    "katex": "^0.19.0",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^22.0.0",
    "html-validate": "^10.0.0",
    "wrangler": "4.85.0",
    "vite-plus": "catalog:"
  }
}
