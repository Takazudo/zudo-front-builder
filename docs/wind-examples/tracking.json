{
  "schemaVersion": 1,
  "family": "tracking",
  "examples": [
    {
      "id": "tracking-compare",
      "kind": "positive",
      "html": "<div class=\"wind-demo-tracking\">\n  <p><span class=\"wind-demo-label\">Tight</span><span class=\"tracking-tight\">SHORT LABEL / 短いラベル</span></p>\n  <p><span class=\"wind-demo-label\">Wide</span><span class=\"tracking-wide\">SHORT LABEL / 短いラベル</span></p>\n</div>",
      "utilities": ["tracking-tight", "tracking-wide"],
      "authoredClasses": ["wind-demo-tracking", "wind-demo-label"],
      "scaffoldCss": ".wind-demo-tracking { color: #223247; border: 1px solid #b7c5d4; padding: 1rem; overflow-wrap: anywhere; }\n.wind-demo-tracking p { margin: 0; padding: 0.45rem 0; border-bottom: 1px solid #d8e0e8; }\n.wind-demo-tracking p:last-child { border-bottom: 0; }\n.wind-demo-label { display: inline-block; width: 4rem; color: #5d6c7c; font-size: 0.8rem; }\n",
      "config": {
        "wind": {
          "tokens": {
            "letterSpacings": {
              "tight": "-0.03em",
              "wide": "0.1em"
            }
          }
        }
      }
    },
    {
      "id": "tracking-custom",
      "kind": "positive",
      "html": "<p class=\"wind-demo-tracking-custom tracking-[0.12em]\">A little extra space / 少し広めの字間</p>",
      "utilities": ["tracking-[0.12em]"],
      "authoredClasses": ["wind-demo-tracking-custom"],
      "scaffoldCss": ".wind-demo-tracking-custom { color: #223247; border-left: 3px solid #6d7f96; padding: 0.5rem 0.75rem; }\n",
      "config": {
        "wind": {
          "tokens": {
            "letterSpacings": {
              "tight": "-0.03em",
              "wide": "0.1em"
            }
          }
        }
      }
    }
  ]
}
