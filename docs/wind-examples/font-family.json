      "kind": "positive",
      "html": "<div class=\"wind-demo-family\">\n  <p><span class=\"wind-demo-label\">Interface</span><span class=\"font-ui\">A clear system sans / 読みやすいサンセリフ</span></p>\n  <p><span class=\"wind-demo-label\">Reading</span><span class=\"font-reading\">A serif voice / セリフ体の雰囲気</span></p>\n  <p><span class=\"wind-demo-label\">Code</span><span class=\"font-code\">const value = 42;</span></p>\n</div>",
      "utilities": ["font-ui", "font-reading", "font-code"],
      "authoredClasses": ["wind-demo-family", "wind-demo-label"],
      "scaffoldCss": ".wind-demo-family { color: #223247; border: 1px solid #b7c5d4; padding: 1rem; }\n.wind-demo-family p { margin: 0; padding: 0.45rem 0; border-bottom: 1px solid #d8e0e8; }\n.wind-demo-family p:last-child { border-bottom: 0; }\n.wind-demo-label { display: inline-block; width: 5.5rem; color: #5d6c7c; font-size: 0.8rem; }\n",
      "config": {
        "wind": {
          "tokens": {
            "fontFamilies": {
              "ui": "system-ui, sans-serif",
              "reading": "Georgia, 'Times New Roman', serif",
              "code": "ui-monospace, monospace"
            }
          }
        }
      }
    },
    {
