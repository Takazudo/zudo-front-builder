      "html": "<div class=\"wind-demo-weight\">\n  <p><span class=\"wind-demo-label\">Regular</span><span class=\"font-regular\">The same words at regular weight</span></p>\n  <p><span class=\"wind-demo-label\">Medium</span><span class=\"font-medium\">The same words at medium weight</span></p>\n  <p><span class=\"wind-demo-label\">Strong</span><span class=\"font-strong\">The same words at strong weight</span></p>\n</div>",
      "utilities": ["font-regular", "font-medium", "font-strong"],
