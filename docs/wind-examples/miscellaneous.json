{
  "schemaVersion": 1,
  "family": "miscellaneous",
  "examples": [
    {
      "id": "vertical-alignment",
      "kind": "positive",
      "html": "<p class=\"wind-demo-align-line\">Text baseline <span class=\"wind-demo-swatch align-baseline\">baseline</span> <span class=\"wind-demo-swatch align-top\">top</span> <span class=\"wind-demo-swatch align-middle\">middle</span> <span class=\"wind-demo-swatch align-bottom\">bottom</span></p>",
      "utilities": ["align-baseline", "align-top", "align-middle", "align-bottom"],
      "authoredClasses": ["wind-demo-align-line", "wind-demo-swatch"],
      "scaffoldCss": ".wind-demo-align-line { margin: 0; max-width: 38rem; border-bottom: 1px solid #a7bacd; color: #24364b; font: 16px/3 system-ui, sans-serif; }\n.wind-demo-swatch { border: 1px solid #6c88a4; background: #e4eff9; padding: 0.2rem; font-size: 1.1rem; line-height: 1; }\n"
    },
    {
      "id": "box-sizing",
      "kind": "positive",
      "html": "<div class=\"wind-demo-boxes\"><div class=\"wind-demo-box box-border\">border-box<br>12rem total</div><div class=\"wind-demo-box box-content\">content-box<br>12rem content</div></div>",
      "utilities": ["box-border", "box-content"],
      "authoredClasses": ["wind-demo-boxes", "wind-demo-box"],
      "scaffoldCss": ".wind-demo-boxes { display: flex; flex-wrap: wrap; align-items: start; gap: 1rem; color: #24364b; font: 14px/1.5 system-ui, sans-serif; }\n.wind-demo-box { width: 12rem; border: 4px solid #52779a; background: #e4eff9; padding: 1rem; }\n"
    },
    {
      "id": "object-fit-options",
      "kind": "positive",
      "html": "<div class=\"wind-demo-object-grid\"><figure class=\"wind-demo-object-card\"><figcaption>contain</figcaption><span class=\"wind-demo-frame\"><img width=\"160\" height=\"100\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'160'%20height%3D'100'%20viewBox%3D'0%200%20160%20100'%3E%3Crect%20width%3D'160'%20height%3D'100'%20fill%3D'%23dbeafe'%2F%3E%3Ccircle%20cx%3D'48'%20cy%3D'50'%20r%3D'32'%20fill%3D'%231d4ed8'%2F%3E%3Crect%20x%3D'96'%20y%3D'15'%20width%3D'54'%20height%3D'70'%20rx%3D'8'%20fill%3D'%23f97316'%2F%3E%3C%2Fsvg%3E\" alt=\"Blue circle and orange rounded rectangle on a pale blue field\" class=\"wind-demo-image object-contain\"></span></figure><figure class=\"wind-demo-object-card\"><figcaption>cover</figcaption><span class=\"wind-demo-frame\"><img width=\"160\" height=\"100\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'160'%20height%3D'100'%20viewBox%3D'0%200%20160%20100'%3E%3Crect%20width%3D'160'%20height%3D'100'%20fill%3D'%23dbeafe'%2F%3E%3Ccircle%20cx%3D'48'%20cy%3D'50'%20r%3D'32'%20fill%3D'%231d4ed8'%2F%3E%3Crect%20x%3D'96'%20y%3D'15'%20width%3D'54'%20height%3D'70'%20rx%3D'8'%20fill%3D'%23f97316'%2F%3E%3C%2Fsvg%3E\" alt=\"Blue circle and orange rounded rectangle on a pale blue field\" class=\"wind-demo-image object-cover\"></span></figure><figure class=\"wind-demo-object-card\"><figcaption>fill</figcaption><span class=\"wind-demo-frame\"><img width=\"160\" height=\"100\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'160'%20height%3D'100'%20viewBox%3D'0%200%20160%20100'%3E%3Crect%20width%3D'160'%20height%3D'100'%20fill%3D'%23dbeafe'%2F%3E%3Ccircle%20cx%3D'48'%20cy%3D'50'%20r%3D'32'%20fill%3D'%231d4ed8'%2F%3E%3Crect%20x%3D'96'%20y%3D'15'%20width%3D'54'%20height%3D'70'%20rx%3D'8'%20fill%3D'%23f97316'%2F%3E%3C%2Fsvg%3E\" alt=\"Blue circle and orange rounded rectangle on a pale blue field\" class=\"wind-demo-image object-fill\"></span></figure><figure class=\"wind-demo-object-card\"><figcaption>none</figcaption><span class=\"wind-demo-frame\"><img width=\"160\" height=\"100\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'160'%20height%3D'100'%20viewBox%3D'0%200%20160%20100'%3E%3Crect%20width%3D'160'%20height%3D'100'%20fill%3D'%23dbeafe'%2F%3E%3Ccircle%20cx%3D'48'%20cy%3D'50'%20r%3D'32'%20fill%3D'%231d4ed8'%2F%3E%3Crect%20x%3D'96'%20y%3D'15'%20width%3D'54'%20height%3D'70'%20rx%3D'8'%20fill%3D'%23f97316'%2F%3E%3C%2Fsvg%3E\" alt=\"Blue circle and orange rounded rectangle on a pale blue field\" class=\"wind-demo-image object-none\"></span></figure><figure class=\"wind-demo-object-card\"><figcaption>scale-down</figcaption><span class=\"wind-demo-frame\"><img width=\"160\" height=\"100\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'160'%20height%3D'100'%20viewBox%3D'0%200%20160%20100'%3E%3Crect%20width%3D'160'%20height%3D'100'%20fill%3D'%23dbeafe'%2F%3E%3Ccircle%20cx%3D'48'%20cy%3D'50'%20r%3D'32'%20fill%3D'%231d4ed8'%2F%3E%3Crect%20x%3D'96'%20y%3D'15'%20width%3D'54'%20height%3D'70'%20rx%3D'8'%20fill%3D'%23f97316'%2F%3E%3C%2Fsvg%3E\" alt=\"Blue circle and orange rounded rectangle on a pale blue field\" class=\"wind-demo-image object-scale-down\"></span></figure></div>",
      "utilities": [
        "object-contain",
        "object-cover",
        "object-fill",
        "object-none",
        "object-scale-down"
      ],
      "authoredClasses": [
        "wind-demo-object-grid",
        "wind-demo-object-card",
        "wind-demo-frame",
        "wind-demo-image"
      ],
      "scaffoldCss": ".wind-demo-object-grid { display: flex; flex-wrap: wrap; gap: 0.8rem; color: #24364b; font: 13px/1.4 system-ui, sans-serif; }\n.wind-demo-object-card { display: grid; gap: 0.3rem; margin: 0; }\n.wind-demo-frame { display: block; width: 7rem; height: 5rem; overflow: hidden; border: 1px solid #849bb3; background: #f2f6fa; }\n.wind-demo-image { display: block; width: 7rem; height: 5rem; }\n"
    },
    {
      "id": "supplemental-sr-only",
      "kind": "positive",
      "html": "<div class=\"wind-demo-sr-example\"><button type=\"button\" class=\"wind-demo-sr-button\">Save<span class=\"sr-only\"> profile changes</span></button><p>The visible “Save” label stands on its own; the visually hidden words add optional context for a screen reader.</p></div>",
      "utilities": ["sr-only"],
      "authoredClasses": ["wind-demo-sr-example", "wind-demo-sr-button"],
      "scaffoldCss": ".wind-demo-sr-example { display: grid; justify-items: start; gap: 0.7rem; max-width: 30rem; color: #24364b; font: 15px/1.5 system-ui, sans-serif; }\n.wind-demo-sr-example p { margin: 0; }\n.wind-demo-sr-button { border: 1px solid #526477; border-radius: 0.35rem; background: #eef3f8; padding: 0.55rem 0.8rem; color: inherit; font: inherit; }\n.wind-demo-sr-button:focus-visible { outline: 3px solid #1670b8; outline-offset: 3px; }\n"
    }
  ]
}
