node_modules
dist

# zfb build artifacts (doc-history-meta.json + build output are regenerated)
.zfb/
.zfb-build/

# zudo-doc build artifact (routes-src/ staged here at build time)
.zudo-doc/

# Wrangler local state/tmp written by `pnpm preview` (wrangler dev).
