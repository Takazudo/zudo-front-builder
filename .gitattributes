# Enforce LF line endings for JS/TS source and shell scripts to prevent
# CRLF issues on Windows checkouts. The bin shim must be LF-only so the
# shebang line is interpreted correctly on Unix systems.
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf

# This fixture is an exact byte-for-byte zudo-wind output golden. The CSS
# pipeline can retain a final blank line at its combine boundary.
crates/zfb/tests/fixtures/css-determinism/golden.css whitespace=-blank-at-eof
