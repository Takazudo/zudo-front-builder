import {
  getCollection,
  getContentSnapshot,
  type CollectionEntry,
  type SnapshotEntry,
} from "@takazudo/zfb/content";
import specification from "./spec.json";

export const spec = specification;

export type ArticleData = {
  slug: string;
  title: string;
  description: string;
  date: string;
  category: string;
  categoryLabel: string;
  author: string;
  readingMinutes: number;
};

export type Article = CollectionEntry<ArticleData>;

type ArticleIndex = {
  articles: Article[];
  bySlug: Map<string, Article>;
  categories: Map<string, Article[]>;
  related: Map<string, Article[]>;
};

// Keep index construction lazy, and reuse it only for the same collection
// snapshot. Reading the collection slot on EVERY call is intentional: ZFB dev
// observes that read to attribute a content dependency to the current route.
// Returning a module-level cache before this read hides later route consumers.
let index: ArticleIndex | undefined;
let indexedEntries: readonly SnapshotEntry[] | undefined;

export function getIndex(): ArticleIndex {
  const entries = getContentSnapshot()?.collections.articles;
  if (entries !== undefined && index && entries === indexedEntries) return index;
  const articles = getCollection<ArticleData>("articles").sort((a, b) =>
    a.slug.localeCompare(b.slug, "en"),
  );
  const bySlug = new Map(articles.map((article) => [article.slug, article]));
  const categories = new Map<string, Article[]>(
    spec.categories.map((category) => [category.slug, []]),
  );
  for (const article of articles) {
    if (article.data.slug !== article.slug) {
      throw new Error(`Article slug mismatch: ${article.slug}`);
    }
    const category = categories.get(article.data.category);
    if (!category) throw new Error(`Unknown article category: ${article.data.category}`);
    category.push(article);
  }
  const related = new Map<string, Article[]>();
  for (const category of categories.values()) {
    category.forEach((article, position) => {
      const next: Article[] = [];
      for (let offset = 1; offset <= Math.min(3, category.length - 1); offset++) {
        next.push(category[(position + offset) % category.length]!);
      }
      related.set(article.slug, next);
    });
  }
  index = { articles, bySlug, categories, related };
  indexedEntries = entries;
  return index;
}

export function articleAt(slug: string): Article {
  const article = getIndex().bySlug.get(slug);
  if (!article) throw new Error(`Unknown article: ${slug}`);
  return article;
}
