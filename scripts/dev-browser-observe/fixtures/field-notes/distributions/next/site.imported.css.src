:root{color-scheme:light;--paper:#f5f2e9;--ink:#203b34;--muted:#6a756d;--line:#d5dacf;--accent:#df653a;--card:#fffef8;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper)}
*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:4px}img{max-width:100%;height:auto;display:block}p{line-height:1.7}h1,h2,h3,p{margin-top:0}h1,h2,h3{letter-spacing:-.035em}a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
.site-header{border-bottom:1px solid var(--line)}.header-inner{max-width:1240px;padding:27px 30px;margin:auto;display:flex;align-items:center;gap:52px}.brand{font-size:22px;font-weight:900;letter-spacing:-1px;white-space:nowrap}.brand span{font-weight:400;margin-left:5px}.header-inner nav{display:flex;gap:27px;font-size:13px}.edition{margin-left:auto;font-size:9px;font-weight:700;letter-spacing:1.7px;color:var(--muted)}.site-main{max-width:1240px;margin:0 auto;padding:0 30px 80px}.hero{padding:70px 0 54px;display:flex;justify-content:space-between;gap:30px;align-items:center}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:700;text-transform:uppercase;color:var(--accent);margin-bottom:20px}.hero h1{font-family:Georgia,'Times New Roman',serif;font-size:66px;font-weight:400;line-height:1.08;margin-bottom:22px}.lede{font-size:17px;line-height:1.7;color:var(--muted);max-width:650px;margin-bottom:0}.hero-stat{border-left:1px solid var(--line);padding:15px 0 15px 40px;min-width:200px}.hero-stat strong{display:block;font-family:Georgia,serif;font-size:58px;font-weight:400;letter-spacing:-3px}.hero-stat span{font-size:11px;color:var(--muted)}.categories{display:flex;flex-wrap:wrap;gap:9px;padding:0 0 42px;border-bottom:1px solid var(--line)}.categories a{border:1px solid var(--line);border-radius:30px;padding:8px 13px;font-size:11px}.categories a:hover{background:var(--ink);color:var(--paper);text-decoration:none}.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin:39px 0 23px}.section-heading h2{font-size:25px;margin:0;font-weight:600}.section-heading>a{font-size:12px}.card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 25px}.post-card{background:var(--card);border:1px solid var(--line);overflow:hidden}.card-art{display:block;background:#dce2ce;overflow:hidden}.card-art img{width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .2s}.card-art:hover img{transform:scale(1.015)}.card-content{padding:22px 23px 24px}.card-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:9px;text-transform:uppercase;letter-spacing:.7px;margin-bottom:15px}.card-meta>a{font-weight:700;color:var(--accent)}.card-meta>span{color:var(--muted)}.post-card h3{font-family:Georgia,serif;font-size:23px;font-weight:400;line-height:1.25;margin-bottom:13px}.card-content>p:not(.card-meta){font-size:12px;color:var(--muted);margin-bottom:20px}.reading-time{font-size:10px;color:var(--muted);letter-spacing:.3px}.site-footer{max-width:1180px;margin:auto;padding:35px 0 45px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:25px}.site-footer strong{font-size:12px;letter-spacing:1px}.site-footer p{font-size:11px;color:var(--muted);margin:10px 0 0}.listing-header{padding:65px 0 45px}.listing-header h1{font-family:Georgia,serif;font-size:58px;font-weight:400;margin-bottom:15px}.pagination{display:flex;justify-content:center;gap:35px;align-items:center;margin-top:45px;padding:20px 0;font-size:13px}.pagination>span{color:var(--muted)}.archive-link{text-align:center;margin-top:35px;font-size:13px}.breadcrumb{display:flex;gap:12px;padding-top:35px;font-size:11px;color:var(--muted)}.article{max-width:800px;margin:0 auto}.article-header{padding:48px 0 32px}.article-header h1{font-family:Georgia,serif;font-size:49px;line-height:1.12;font-weight:400;margin-bottom:22px}.article-meta{display:flex;gap:22px;font-size:11px;margin-top:25px;color:var(--muted)}.article-cover{width:100%;margin-bottom:44px;border:1px solid var(--line)}.prose{max-width:700px;margin:auto;font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.8;color:#34483f}.prose p{line-height:1.8;margin-bottom:25px}.prose h2{font-family:Arial,sans-serif;font-size:27px;margin:40px 0 20px;line-height:1.25}.prose h3{font-family:Arial,sans-serif;font-size:21px;margin:30px 0 18px}.prose ul,.prose ol{padding-left:25px;margin:24px 0}.prose li{padding-left:6px;margin:8px 0}.prose blockquote{border-left:3px solid var(--accent);padding:4px 0 4px 24px;margin:28px 0;font-style:italic;color:var(--muted)}.prose blockquote p{margin:0}.prose a{text-decoration:underline;text-underline-offset:3px}.prose code{font-family:monospace;font-size:.83em;background:#e9ebe1;padding:3px 5px;border-radius:3px}.related{border-top:1px solid var(--line);padding-top:5px;margin-top:70px}
.prose li>p{margin:0}
@media(max-width:850px){.edition{display:none}.hero h1{font-size:51px}.hero-stat{min-width:170px;padding-left:25px}.hero-stat strong{font-size:48px}.card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.site-footer{margin:0 30px}.article-header h1{font-size:42px}}
@media(max-width:560px){.header-inner{padding:22px 20px;gap:22px;flex-wrap:wrap}.header-inner nav{gap:18px;font-size:12px}.brand{font-size:20px}.site-main{padding:0 20px 50px}.hero{padding:43px 0 32px;display:block}.hero h1{font-size:43px}.hero-stat{border-left:0;padding:25px 0 0;display:flex;align-items:baseline;gap:15px}.hero-stat strong{font-size:37px}.lede{font-size:15px}.categories{padding-bottom:28px}.categories a{font-size:10px;padding:7px 10px}.card-grid{grid-template-columns:1fr;gap:22px}.section-heading{margin-top:28px}.section-heading h2{font-size:21px}.section-heading>a{font-size:10px}.site-footer{margin:0 20px;display:block}.site-footer>p{margin-top:25px}.listing-header{padding:45px 0 30px}.listing-header h1{font-size:43px}.article-header{padding:35px 0 25px}.article-header h1{font-size:36px}.article-meta{gap:13px;font-size:10px}.prose{font-size:16px}.prose h2{font-size:24px}.related{margin-top:45px}}
