{
  "$id": "field-notes-fixture.v1",
  "title": "dev-browser-observe Field Notes fixture manifest",
  "type": "object",
  "required": [
    "schema",
    "name",
    "source",
    "adapters",
    "paths",
    "layoutFooter",
    "publicCss",
    "managedCss"
  ],
  "properties": {
    "schema": {
      "const": "field-notes-fixture.v1"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["app", "helper", "content", "shared", "datasetSha256"]
    },
    "adapters": {
      "type": "object",
      "required": ["target", "variants"]
    },
    "paths": {
      "type": "object",
      "required": ["layout", "publicCss"]
    },
    "layoutFooter": {
      "type": "string"
    },
    "publicCss": {
      "type": "object",
      "required": ["file", "customProperty"]
    },
    "managedCss": {
      "type": "object",
      "required": ["file", "target", "customProperty", "sha256"]
    },
    "placements": {
      "type": "object",
      "required": ["external"],
      "description": "Content placements. external is the source layout; any other entry is a derived overlay with provenance, base and overlay sha256 and the exact diff.",
      "additionalProperties": {
        "type": "object",
        "required": ["provenance", "contentDest", "collectionPath"],
        "properties": {
          "provenance": {
            "enum": ["source-dir", "derived"]
          },
          "contentDest": {
            "type": "string"
          },
          "collectionPath": {
            "type": "string"
          },
          "allowOutsideRoot": {
            "type": "boolean"
          },
          "config": {
            "type": "object",
            "required": ["target", "overlay", "baseSha256", "overlaySha256", "diff"]
          }
        }
      }
    }
  }
}
