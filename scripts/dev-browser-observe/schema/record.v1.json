{
  "$id": "dev-browser-observe.record.v1",
  "title": "One line of <out>/<label>/records.jsonl",
  "type": "object",
  "required": ["seq", "at", "type"],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "string"
    },
    "type": {
      "enum": [
        "run-start",
        "identity",
        "server-ready",
        "browser-ready",
        "scenario-start",
        "warm",
        "precheck",
        "attempt",
        "late-token",
        "supplemental",
        "cleanup",
        "batch-end",
        "calibration",
        "server-stop",
        "controller-error",
        "run-end",
        "inject",
        "control-not-fired"
      ]
    },
    "label": {
      "enum": ["measured", "supplemental", "cleanup", "calibration", "not-success", "unmeasured"]
    },
    "outcome": {
      "enum": [
        "success",
        "timeout",
        "stale",
        "precondition-failed",
        "arm-error",
        "prepare-error",
        "precondition-unstable",
        "write-error",
        "server-exit",
        "resource-limit",
        "supplemental-failed",
        "restoration-failed",
        "identity-rejected",
        "ready-failed",
        "not-implemented",
        "controller-error",
        "materialize-error",
        "expected-negative-observed",
        "expected-negative-mismatch",
        "recovery-failed",
        "final-state-mismatch",
        "hidden-precondition-visited",
        "rename-noop",
        "recovery-observed",
        "recovery-state-mismatch",
        "not-same-tick",
        "same-tick-unknown",
        "recovery-error",
        "rejection-not-observed",
        "open-page-replaced"
      ]
    },
    "latencyMs": {
      "type": "number"
    },
    "endpoint": {
      "const": "predicate confirmed + 2 rAF + binding delivery"
    },
    "mechanism": {
      "enum": [
        "native-full-reload",
        "full-reload-without-page-frame",
        "css-replacement",
        "in-document-update",
        "server-restart",
        "unclassified"
      ]
    }
  }
}
