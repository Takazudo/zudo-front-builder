      "set": "workload",
      "warmOrder": "detail-first",
      "warmDetail": "a",
      "ops": [
        {
          "id": "title-a-home",
          "op": "edit-title",
          "article": "a",
          "writeMethod": "in-place",
          "targetPath": "/",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "a1-prov-detail-first-body-a-detail",
      "set": "workload",
      "warmOrder": "detail-first",
      "warmDetail": "a",
      "ops": [
        {
          "id": "body-a-detail",
