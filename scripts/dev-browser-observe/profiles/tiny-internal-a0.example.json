{
  "schema": "dev-browser-observe.profile.v1",
  "description": "Tiny fixture, internal content, A0 helper. Fill productSha, buildReceipt and pins (cli.mjs pins) before use.",
  "mode": "source-built",
  "diagnostic": false,
  "productSha": "0000000000000000000000000000000000000000",
  "productDirtyIdentity": null,
  "buildReceipt": "/tmp/dev-browser-observe/build-receipt.json",
  "fixture": {
    "dir": "../fixtures/tiny-two-article",
    "placement": "internal",
    "adapter": "A0"
  },
  "pins": {
    "harnessTreeSha256": null,
    "fixtureTreeSha256": null,
    "observerSha256": null,
    "adapterSha256": null
  },
  "server": {
    "port": {
      "mode": "ephemeral"
    },
    "host": "127.0.0.1",
    "readyTimeoutMs": 120000
  },
  "browser": {
    "headless": true,
    "args": [
      "--disable-background-timer-throttling",
      "--disable-renderer-backgrounding",
      "--disable-backgrounding-occluded-windows"
    ],
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "deviceScaleFactor": 1
  },
  "timeouts": {
    "attemptMs": 30000,
    "supplementalMs": 30000,
    "restoreMs": 30000,
    "stopTermMs": 5000,
    "stopKillMs": 3000
  },
  "limits": {
    "rssCeilingKiB": 4194304,
    "wallCeilingMs": 1800000
  },
  "calibration": {
    "repeats": 5,
    "staleTimeoutMs": 2000,
    "cells": [
      "binding-round-trip",
      "two-raf",
      "synthetic-dom",
      "synthetic-css",
      "observer-init-after-navigation",
      "stale-then-new-token",
      "late-token",
      "native-reload-survival"
    ]
  },
  "restoration": {
    "writeMethod": "in-place"
  },
  "scenarios": [
    {
      "id": "s1-title-body-category",
      "set": "workload",
      "ops": [
        {
          "id": "title-a",
          "op": "edit-title",
          "article": "a",
          "writeMethod": "in-place"
        },
        {
          "id": "body-a",
          "op": "edit-body",
          "article": "a",
          "writeMethod": "in-place"
        },
        {
          "id": "category-b",
          "op": "edit-category",
          "article": "b",
          "writeMethod": "in-place"
        }
      ]
    },
    {
      "id": "s2-css",
      "set": "workload",
      "ops": [
        {
          "id": "css-independent",
          "op": "edit-css",
          "writeMethod": "in-place"
        }
      ]
    }
  ],
  "outDir": "/tmp/dev-browser-observe"
}
