{
  "schema": "dev-browser-observe.profile.v1",
  "description": "Provenance diagnostic, Field Notes, original memoized helper, external placement: ZFB_DEV_TIMING=1 and ZFB_DEV_PROVENANCE_TRACE=1, so each attempt record carries provenance.causalChain. Covers title (detail and home), body, description, a category move, an add, a slug-changing rename, and a CSS edit in a rejected tick (rejected generation retained, then the repair). Run families individually with --scenario. Fill productSha, buildReceipt, outDir, pins and fixture.source.dir.",
  "mode": "source-built",
  "diagnostic": true,
  "productSha": "0000000000000000000000000000000000000000",
  "productDirtyIdentity": null,
  "buildReceipt": "/tmp/dev-browser-observe/build-receipt.json",
  "fixture": {
    "kind": "field-notes",
    "dir": "../fixtures/field-notes",
    "adapter": "original-memoized",
    "managedCss": true,
    "source": {
      "dir": "/REPLACE/with/fieldnotes/src-100",
      "appsZfbTreeSha256": "5e5580347095d9c5817faf3d4aa30529913e1a0c26a6b1b80905b5b01fa9ba36",
      "contentTreeSha256": "22763056bd34e0a5dd6e4ac096e69de7e0278519235df88666124c801ea0b7a7",
      "sharedTreeSha256": "f709ace99f2aad0d1c7c1d553c8693b66883f1055168855fb6807722b0cf226a",
      "datasetSha256": "fcaa222e52caaedb411a4136f106d4ddb5eaa7334a3ef03f34ccd282f6bab58a"
    }
  },
  "pins": {
    "harnessTreeSha256": null,
    "fixtureTreeSha256": null,
    "observerSha256": null,
    "adapterSha256": null
  },
  "server": {
    "port": {
      "mode": "ephemeral"
    },
    "host": "127.0.0.1",
    "readyTimeoutMs": 180000,
    "env": {
      "ZFB_DEV_TIMING": "1",
      "ZFB_DEV_PROVENANCE_TRACE": "1"
    }
  },
  "browser": {
    "headless": true,
    "args": [
      "--disable-background-timer-throttling",
      "--disable-renderer-backgrounding",
      "--disable-backgrounding-occluded-windows"
    ],
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "deviceScaleFactor": 1
  },
  "timeouts": {
    "attemptMs": 30000,
    "supplementalMs": 30000,
    "restoreMs": 60000,
    "stopTermMs": 5000,
    "stopKillMs": 3000,
    "quietMs": 3000
  },
  "limits": {
    "rssCeilingKiB": 4194304,
    "wallCeilingMs": 1800000,
    "sampleEveryMs": 1000
  },
  "calibration": {
    "repeats": 3,
    "staleTimeoutMs": 2000,
    "cells": [
      "binding-round-trip",
      "two-raf",
      "synthetic-dom",
      "synthetic-css",
      "observer-init-after-navigation",
      "stale-then-new-token",
      "late-token",
      "reload-survival-controller-triggered",
      "native-reload-survival"
    ]
  },
  "restoration": {
    "writeMethod": "in-place"
  },
  "scenarios": [
    {
      "id": "prov-title-detail",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "title-05-detail",
          "op": "edit-title",
          "article": "article-00005",
          "writeMethod": "in-place",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-title-home",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "title-06-home",
          "op": "edit-title",
          "article": "article-00006",
          "writeMethod": "in-place",
          "targetPath": "/",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-edit-body",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "body-05",
          "op": "edit-body",
          "article": "article-00005",
          "writeMethod": "in-place",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-prop-description-detail",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "description-10-detail",
          "op": "edit-prop",
          "prop": "description",
          "article": "article-00010",
          "writeMethod": "in-place",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-category",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "category-15",
          "op": "edit-category",
          "article": "article-00015",
          "writeMethod": "in-place",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-add-article",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "add-101",
          "op": "add-article",
          "writeMethod": "create",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-rename-slug-change",
      "set": "workload",
      "warmOrder": "none",
      "ops": [
        {
          "id": "rename-07",
          "op": "rename-slug-change",
          "article": "article-00007",
          "writeMethod": "rename",
          "expect": "classify"
        }
      ]
    },
    {
      "id": "prov-recovery-css-in-rejected-tick",
      "set": "recovery",
      "warmOrder": "none",
      "ops": [
        {
          "id": "css-rejected-20",
          "op": "css-in-rejected-tick",
          "article": "article-00020",
          "writeMethod": "in-place",
          "expectState": ["error", "last-good"],
          "requireSameTick": true
        }
      ]
    }
  ],
  "outDir": "/tmp/dev-browser-observe"
}
