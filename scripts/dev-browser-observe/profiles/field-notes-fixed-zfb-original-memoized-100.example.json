    "env": {
      "ASTRO_TELEMETRY_DISABLED": "1",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "browser": {
    "headless": true,
    "args": [
      "--disable-background-timer-throttling",
      "--disable-renderer-backgrounding",
      "--disable-backgrounding-occluded-windows"
    ],
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "deviceScaleFactor": 1
  },
  "timeouts": {
    "attemptMs": 30000,
    "supplementalMs": 30000,
    "restoreMs": 60000,
    "stopTermMs": 5000,
    "stopKillMs": 3000,
    "quietMs": 3000
  },
  "limits": {
    "rssCeilingKiB": 4194304,
    "wallCeilingMs": 3600000,
    "sampleEveryMs": 1000
