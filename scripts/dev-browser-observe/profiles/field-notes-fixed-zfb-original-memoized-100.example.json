{
  "schema": "dev-browser-observe.profile.fixed-distribution.v1",
  "description": "Fixed ZFB reference (@takazudo/zfb + zfb-runtime 6.0.1, the archive's original memoized helper) at scale 100, timing protocol scenarios (2 warmups + 10 measured per op). Historical stale/timeout outcomes are recorded failures and stop the session. Fill distribution.installDir (install-distribution --framework zfb), fixture.source.dir, outDir and pins (cli.mjs pins).",
  "mode": "fixed-distribution",
  "diagnostic": false,
  "framework": "zfb",
  "distribution": {
    "installDir": "/REPLACE/with/installs/zfb",
    "launch": "direct"
  },
  "fixture": {
    "kind": "field-notes",
    "dir": "../fixtures/field-notes",
    "adapter": "original-memoized",
    "scale": 100,
    "placement": "external",
    "importedCss": true,
    "source": {
      "dir": "/REPLACE/with/fieldnotes/src-100",
      "appsZfbTreeSha256": "5e5580347095d9c5817faf3d4aa30529913e1a0c26a6b1b80905b5b01fa9ba36",
      "contentTreeSha256": "22763056bd34e0a5dd6e4ac096e69de7e0278519235df88666124c801ea0b7a7",
      "sharedTreeSha256": "f709ace99f2aad0d1c7c1d553c8693b66883f1055168855fb6807722b0cf226a",
      "datasetSha256": "fcaa222e52caaedb411a4136f106d4ddb5eaa7334a3ef03f34ccd282f6bab58a"
    }
  },
  "pins": {
