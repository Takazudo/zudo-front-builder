  "server": {
    "port": {
      "mode": "ephemeral"
    },
    "host": "127.0.0.1",
    "readyTimeoutMs": 180000
  },
  "browser": {
    "headless": true,
    "args": [
      "--disable-background-timer-throttling",
      "--disable-renderer-backgrounding",
      "--disable-backgrounding-occluded-windows"
    ],
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "deviceScaleFactor": 1
  },
  "timeouts": {
    "attemptMs": 30000,
    "supplementalMs": 30000,
    "restoreMs": 60000,
    "stopTermMs": 5000,
    "stopKillMs": 3000,
    "quietMs": 1500
  },
  "limits": {
    "rssCeilingKiB": 4194304,
    "wallCeilingMs": 1800000,
    "sampleEveryMs": 1000
