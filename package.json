{
  "name": "zudo-front-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "zudo-front-builder — frontend build orchestrator (private workspace)",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "//// === ROOT ===": "",
    "prepare": "[ -d .git ] && (lefthook install --reset-hooks-path || true) && bash scripts/install-git-hooks.sh || true",
    "init-worktree": "bash scripts/install-git-hooks.sh",
    "//// === BINARIES ===": "",
    "fetch:tailwind": "node scripts/fetch-tailwind.mjs",
    "sync:platform-versions": "node scripts/sync-platform-versions.mjs",
    "//// === DOCS ===": "",
    "docs:install": "pnpm --filter docs install",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "docs:check": "pnpm --filter docs check",
    "//// === FORMAT ===": "",
    "format": "pnpm format:ts && pnpm format:mdx",
    "format:check": "pnpm format:check:ts && pnpm format:check:mdx",
    "format:ts": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "format:check:ts": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "format:mdx": "pnpm dlx @takazudo/mdx-formatter@1.2.1 --write '**/*.{md,mdx}'",
    "format:check:mdx": "pnpm dlx @takazudo/mdx-formatter@1.2.1 --check '**/*.{md,mdx}'",
    "//// === VALIDATION ===": "",
    "b4push": "bash scripts/run-b4push.sh",
    "//// === ROOT-LEVEL SCRIPTS (scripts/**) ===": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "//// === CLIENT-ROUTER L4 (Chromium, runs in CI) ===": "",
    "test:router-chromium": "pnpm -C packages/zfb-runtime build && pnpm exec playwright test --config tests/router-chromium/playwright.config.mjs",
    "//// === LOCAL-HEAVY (T4, Mac only, NOT CI) ===": "",
    "test:webkit-back": "pnpm -C packages/zfb-runtime build && pnpm exec playwright test --config tests/webkit-back-history/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "vitest": "^2.1.9",
    "wrangler": "4.85.0"
  }
}
