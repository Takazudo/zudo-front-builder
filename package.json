{
  "name": "zudo-front-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "zudo-front-builder — frontend build orchestrator (private workspace)",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "//// === ROOT ===": "",
    "prepare": "lefthook install --reset-hooks-path",
    "//// === DOCS ===": "",
    "docs:install": "pnpm --filter docs install",

    "//// === FORMAT ===": "",
    "format:mdx": "pnpm dlx @takazudo/mdx-formatter --write '**/*.{md,mdx}'",
    "format:check:mdx": "pnpm dlx @takazudo/mdx-formatter --check '**/*.{md,mdx}'"
  },
  "devDependencies": {
    "lefthook": "^2.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["lefthook"]
  }
}
