+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        project
+            .path()
+            .join(".tmpdir-barrier-child-complete")
+            .is_file(),
+        "child process exited without running the barrier assertions"
