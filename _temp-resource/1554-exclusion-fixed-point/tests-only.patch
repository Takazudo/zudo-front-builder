+#[test]
+fn exact_isolation_has_stable_bundle_and_sourcemap_identity_across_session_ticks() {
+    let Some(esbuild) = locate_esbuild() else {
+        eprintln!("[bundler_exact_match_resolution] no esbuild binary available; skipping.");
+        return;
+    };
+    let esbuild = fs::canonicalize(esbuild).expect("absolute esbuild path");
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let root = tmp.path().to_path_buf();
+    write_fixture_project(&root, "plugin:stable-isolation", "unused.tsx");
+    write_value_page(&root, "plugin:stable-isolation");
+    fs::create_dir_all(root.join(".stable-isolation")).unwrap();
+    fs::write(
+        root.join(".stable-isolation/entry.js"),
+        "export default 'STABLE_EXACT_ISOLATION';\n",
+    )
+    .unwrap();
+    fs::write(
+        root.join("src/unrelated-excluded.ts"),
+        "export default 0;\n",
+    )
+    .unwrap();
+
+    let make_tick = || {
+        let mut input = make_input(
+            &root,
+            &esbuild,
+            "dist-stable-isolation",
+            BTreeMap::new(),
+            vec![(
+                "plugin:stable-isolation".to_string(),
+                root.join(".stable-isolation/entry.js")
+                    .to_string_lossy()
+                    .into_owned(),
+            )],
+            vec![],
+        );
+        input.bundle_exclude = vec!["src/unrelated-excluded.ts".to_string()];
+        input.mode = BundleMode::Development;
+        input
+    };
+    let mut session = ShadowSession::new().unwrap();
+    let first = bundle_with_session(make_tick(), Some(&mut session)).unwrap();
+    let expected_dep = fs::canonicalize(root.join(".stable-isolation/entry.js")).unwrap();
+    assert!(
+        first
+            .route_module_deps
+            .iter()
+            .any(|route| route.module_deps.contains(&expected_dep)),
+        "exact isolation dependency was not mapped back to the project: {:?}",
+        first.route_module_deps
+    );
+    assert!(
+        first.route_module_deps.iter().all(|route| route
+            .module_deps
+            .iter()
+            .all(|dep| !dep.to_string_lossy().contains(".zfb-exact-isolation"))),
+        "route deps leaked disposable isolation identities: {:?}",
+        first.route_module_deps
+    );
+    let first_bundle = fs::read(&first.bundle_path).unwrap();
+    let first_map = fs::read(&first.sourcemap_path).unwrap();
+    let second = bundle_with_session(make_tick(), Some(&mut session)).unwrap();
+    let second_bundle = fs::read(&second.bundle_path).unwrap();
+    let second_map = fs::read(&second.sourcemap_path).unwrap();
+
+    assert_eq!(
+        first_bundle, second_bundle,
+        "bundle identity changed by isolation root"
+    );
+    assert_eq!(
+        first_map, second_map,
+        "sourcemap identity changed by isolation root"
+    );
+    assert!(
+        [&second_bundle, &second_map]
+            .into_iter()
+            .any(|bytes| String::from_utf8_lossy(bytes).contains(".zfb-exact-isolation/view")),
+        "the regression fixture did not traverse the exact isolation view"
+    );
+    for bytes in [&second_bundle, &second_map] {
+        let text = String::from_utf8_lossy(bytes);
+        assert!(!text.contains("zfb-exact-node-modules-"), "{text}");
+        assert!(!text.contains("zfb-exact-isolation-"), "{text}");
+    }
+}
