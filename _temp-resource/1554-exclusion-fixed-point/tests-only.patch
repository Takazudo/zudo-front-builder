+        fs::write(dependency.join("package.json"), r#"{"type":"module"}"#).unwrap();
+        fs::write(
+            dependency.join("secret.js"),
+            "export default 'PROJECT_ANCESTOR_DEPENDENCY_MUST_NOT_LEAK';\n",
+        )
+        .unwrap();
+        let mut input = make_input(
+            &root,
+            &esbuild,
+            "dist-tmpdir-barrier",
+            BTreeMap::new(),
+            vec![(
+                "plugin:tmpdir-barrier".to_string(),
+                root.join(".tmpdir-barrier-entry.js")
+                    .to_string_lossy()
+                    .into_owned(),
+            )],
+            vec![],
+        );
+        input.node_modules_dir = Some(root.join("node_modules"));
+        input.bundle_exclude = vec![dependency
+            .join("secret.js")
+            .strip_prefix(&root)
+            .unwrap()
+            .to_string_lossy()
+            .into_owned()];
+        let error = bundle(input)
+            .expect_err("the isolation poison must stop project-ancestor node_modules lookup");
+        let message = format!("{error:#}");
+        assert!(message.contains("tmpdir-live-dependency"), "{message}");
+        fs::write(root.join(".tmpdir-barrier-child-complete"), "ok").unwrap();
+        return;
+    }
+
+    let Some(esbuild) = locate_esbuild() else {
+        eprintln!("[bundler_exact_match_resolution] no esbuild binary available; skipping.");
+        return;
+    };
+    let project = tempfile::tempdir().expect("project root");
+    let project_local_tmp = project.path().join(".tmp");
+    fs::create_dir_all(&project_local_tmp).unwrap();
+    let output = std::process::Command::new(std::env::current_exe().unwrap())
+        .arg("--exact")
+        .arg("exact_isolation_blocks_project_live_ancestor_when_tmpdir_is_project_local")
+        .arg("--nocapture")
