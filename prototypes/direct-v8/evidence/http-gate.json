      "source": "(async () => { const r = await fetch(\"http://127.0.0.1:43067/binary/data\"); return {status:r.status,url:r.url,redirected:r.redirected,bytes:Array.from(new Uint8Array(await r.arrayBuffer())),cookies:r.headers.getSetCookie(),pair:r.headers.get(\"x-pair\"),headers:Array.from(r.headers)}; })()",
      "expected": {
        "status": 201,
        "url": "http://127.0.0.1:43067/binary/data",
        "redirected": false,
        "bytes": [0, 1, 127, 128, 255],
