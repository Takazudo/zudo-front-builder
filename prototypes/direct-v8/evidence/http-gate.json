      "name": "parallel-handshake-and-microtask",
      "contracts": ["HTTP-04", "BOOT-02"],
      "mode": "request-time",
      "source": "(async () => { let progressed = false; const calls = [\"left\",\"right\"].map(async side => { const response = await fetch(\"http://127.0.0.1:38973/parallel/\" + side); return {side,body:await response.text(),microtaskProgressed:progressed}; }); queueMicrotask(() => { progressed = true; }); return await Promise.all(calls); })()",
      "expected": [
        {
          "side": "left",
          "body": "left",
          "microtaskProgressed": true
        },
        {
          "side": "right",
          "body": "right",
          "microtaskProgressed": true
        }
      ],
      "expected_paths": {
        "/parallel/left": 1,
        "/parallel/right": 1
      },
      "source_sha256": "a749fe65652d3215a2883f95da494e61b36eb583c8b846e4e1bb0c050b637c7f",
