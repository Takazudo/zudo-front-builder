      "name": "parallel-handshake-and-microtask",
      "contracts": ["HTTP-04", "BOOT-02"],
      "mode": "request-time",
      "source": "(async () => { let progressed = false; const calls = [\"left\",\"right\"].map(async side => { const response = await fetch(\"http://127.0.0.1:43067/parallel/\" + side); return {side,body:await response.text(),microtaskProgressed:progressed}; }); queueMicrotask(() => { progressed = true; }); return await Promise.all(calls); })()",
      "expected": [
        {
          "side": "left",
          "body": "left",
          "microtaskProgressed": true
        },
        {
          "side": "right",
          "body": "right",
          "microtaskProgressed": true
        }
      ],
      "expected_paths": {
        "/parallel/left": 1,
        "/parallel/right": 1
      },
      "source_sha256": "5997ccd0802e0624e10ebd79e577646de2268139eedaa1fe940ee7f34de4b98b",
