      "name": "parallel-handshake-and-microtask",
      "contracts": ["HTTP-04", "BOOT-02"],
      "mode": "request-time",
      "source": "(async () => { let progressed = false; const calls = [\"left\",\"right\"].map(async side => { const response = await fetch(\"http://127.0.0.1:35029/parallel/\" + side); return {side,body:await response.text(),microtaskProgressed:progressed}; }); queueMicrotask(() => { progressed = true; }); return await Promise.all(calls); })()",
      "expected": [
        {
          "side": "left",
          "body": "left",
          "microtaskProgressed": true
        },
        {
          "side": "right",
          "body": "right",
          "microtaskProgressed": true
        }
      ],
      "expected_paths": {
        "/parallel/left": 1,
        "/parallel/right": 1
      },
      "source_sha256": "c6d6f92dd5c6636f328d0c1cbd70a7e730a1d16960e30eef83822a6e6b408f6d",
