    {
      "id": "physical-logical-margin",
      "caseIds": ["mx-auto"],
      "kind": "semantic",
      "scope": "Physical left/right versus inline margins; horizontal-tb and vertical-rl, ltr and rtl, with both computed longhands and geometry."
    },
    {
      "id": "zero-without-theme",
      "caseIds": ["p-0-empty"],
      "kind": "generation",
      "scope": "Wind zero padding versus omitted reference rule; absence must be asserted and counted."
    },
    {
      "id": "zero-variable-indirection",
      "caseIds": ["p-0-mapped"],
      "kind": "structural",
      "scope": "Reference var(--spacing-0) plus explicit theme rule versus Wind literal zero; fixed mapped config, no override equivalence promised."
    },
    {
      "id": "padding-expansion",
      "caseIds": ["p-0-mapped", "named-spacing", "configured-p-4"],
      "kind": "structural",
      "scope": "Reference padding shorthand versus Wind four physical longhands; compare parsed writes and browser behavior."
    },
    {
      "id": "named-token-representation",
      "caseIds": ["named-spacing", "named-color"],
      "kind": "structural",
      "scope": "Reference --spacing/--color names and :root,:host rule versus Wind --zw names in zw-tokens layer; both use var(), preserve each rule."
    },
    {
      "id": "numeric-scale-representation",
      "caseIds": ["configured-p-4"],
      "kind": "structural",
      "scope": "Reference configured --spacing:0.25rem in its :root,:host theme rule and padding calculation versus Wind --zw-spacing-unit:0.25rem in @layer zw-tokens/:root and computed literal utility padding. Compare and count both token rules/layers and utility values; shared token declarations occur once per generated stylesheet in composition. No runtime variable override equivalence promised; extra declarations/rules/layers fail."
    },
    {
      "id": "missing-token-diagnostics",
      "caseIds": ["unconfigured-p-4", "undeclared-palette"],
      "kind": "diagnostic",
      "scope": "No generated utility on either side; Wind origin/strictness-sensitive diagnostic versus reference omission. Probe separately."
    },
    {
      "id": "variant-nesting",
      "caseIds": ["hover-block", "breakpoint-block"],
      "kind": "structural",
      "scope": "Reference nested selector/media representation versus Wind flat rules; retain conditions, specificity, and ordering during structural analysis."
    },
    {
      "id": "wind-layer-order-prelude",
      "caseIds": [
        "block",
        "hidden",
        "inline-flex",
        "mx-auto",
        "grid-cols-2",
        "p-0-empty",
        "p-0-mapped",
        "named-spacing",
        "named-color",
        "configured-p-4",
        "hover-block",
        "breakpoint-block"
      ],
      "kind": "structural",
      "scope": "Exact Wind layer-order statement is first and occurs once per expected nonempty generated stylesheet; the reference has no corresponding Wind statement. Compare and count it without removing it. Composition shares one occurrence across all member cases. Extra, missing, reordered or differently named layers/statements remain failures.",
      "statement": "@layer zw-reset, zw-tokens, zfb-hi, base, components;",
      "countUnit": "generated-stylesheet",
      "expectedOccurrences": {
        "wind": 1,
        "reference": 0
      },
      "standaloneAbsentCaseIds": ["unconfigured-p-4", "undeclared-palette", "contents-gap"],
      "emptyStylesheetExpectedOccurrences": {
        "wind": 0,
        "reference": 0
      },
      "compositionRule": "Derive expected nonemptiness from the fixture contract (reset, configured tokens, or resolved utility output), never from actual output. Assert one prelude for the whole nonempty generated stylesheet, including reset/token-only controls, not one per utility/case. An expected empty stylesheet must have none."
    }
  ],
