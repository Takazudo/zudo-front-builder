{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@takazudo/zfb/zudo-react",
    "rootDir": ".",
    "outDir": "../dist/compiled"
  },
  "include": ["**/*.tsx"]
}
